// Minimal capability contract shared by host and guest bindings — one WIT world
// generates Rust/TS/Python bindings, which is why we standardise on it.
package opensmell:vial@0.1.0;

interface transforms {
  /// Apply a transform to one sensor reading given a baseline, returning an output value.
  apply: func(reading: f64, baseline: f64) -> f64;
}

world vial {
  export transforms;
}
